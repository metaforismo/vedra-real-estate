[Unit]
Description=Vedra Real Estate Preview
After=network-online.target
Wants=network-online.target

[Service]
User=vedra
Group=vedra
WorkingDirectory=/opt/vedra
EnvironmentFile=/opt/vedra/.env
ExecStart=/opt/vedra/.venv/bin/python /opt/vedra/scripts/run.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/vedra/data
UMask=0077

[Install]
WantedBy=multi-user.target

# LOCAL TEST ONLY. Copy these values into the private .env, not into Git.
# Populate AI_API_KEY with a new key. Never commit it.
AI_API_BASE_URL=https://api.regolo.ai/v1
AI_API_KEY=
AI_MODEL=qwen3.8-27b
AI_REASONING_EFFORT=xhigh
AI_RESPONSE_FORMAT=json_object
AI_MAX_OUTPUT_TOKENS=4000
AI_TIMEOUT_SECONDS=120
AI_MAX_ANALYSES_PER_RUN=5
# User-supplied example rates, not a fetched/guaranteed tariff.
AI_INPUT_EUR_PER_MILLION=0.50
AI_OUTPUT_EUR_PER_MILLION=2.10

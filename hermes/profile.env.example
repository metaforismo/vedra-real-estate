# Copy the required entries into the dedicated Hermes profile's .env.
# Do not commit the resulting file and do not reuse your personal Hermes profile.
API_SERVER_ENABLED=true
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8645
API_SERVER_KEY=GENERATE_A_RANDOM_DISTINCT_SECRET

# Vedra backend as reachable from the Hermes terminal environment.
VEDRA_BASE_URL=http://127.0.0.1:8000
VEDRA_BRIDGE_TOKEN=SAME_VALUE_AS_VEDRA_ENV
VEDRA_REQUEST_TIMEOUT=180

# Configure the model/provider separately through your normal Hermes setup.
# Provider API billing is separate from the runtime and browser infrastructure.

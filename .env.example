# Vedra configuration. Run: python scripts/setup.py
# This example contains no usable password or API credential.
ADMIN_EMAIL=admin@vedra.local
ADMIN_PASSWORD=
DATA_DIR=./data
SEED_DEMO=true
SCHEDULER_ENABLED=true
PUBLIC_ORIGIN=http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
COOKIE_SECURE=false

# Exact domains only. An empty list disables outbound acquisition.
LIVE_ALLOWED_DOMAINS=
BROWSER_ENABLED=false

# Optional, dedicated Hermes profile. Never expose this gateway to the public UI.
HERMES_BASE_URL=http://127.0.0.1:8645
HERMES_API_KEY=
VEDRA_BRIDGE_TOKEN=
HERMES_TIMEOUT_SECONDS=480

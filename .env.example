# Vedra configuration. Run: python scripts/setup.py
# This example contains no usable password or API credential.
ADMIN_EMAIL=admin@vedra.local
ADMIN_PASSWORD=
DATA_DIR=./data
WORKER_ENABLED=true
SCHEDULER_ENABLED=true
PUBLIC_ORIGIN=http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
COOKIE_SECURE=false

# Exact domains only. An empty list disables outbound acquisition.
IMAGE_ALLOWED_DOMAINS=
LIVE_ALLOWED_DOMAINS=
BROWSER_ENABLED=false

# Optional, dedicated Hermes profile. Never expose this gateway to the public UI.
HERMES_BASE_URL=http://127.0.0.1:8645
HERMES_API_KEY=
VEDRA_BRIDGE_TOKEN=
HERMES_TIMEOUT_SECONDS=480

# PostgreSQL: direct connection or session pooler; leave empty for local SQLite.
DATABASE_URL=
DATABASE_SCHEMA=vedra
DATABASE_POOL_SIZE=4
WORKSPACE_NAME=Vedra

# Regolo Chat Completions. Set the key only in the private server environment.
AI_API_BASE_URL=https://api.regolo.ai/v1
AI_API_KEY=
AI_MODEL=qwen3.8-27b
AI_REASONING_EFFORT=xhigh
AI_RESPONSE_FORMAT=json_object
AI_MAX_OUTPUT_TOKENS=4000
AI_TIMEOUT_SECONDS=120
AI_MAX_ANALYSES_PER_RUN=5

# National OMI public references and on-demand geometry/quote cache.
OMI_ENABLED=false

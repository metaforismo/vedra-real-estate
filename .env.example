# Vedra configuration. Run: python scripts/setup.py
# This example contains no usable password or API credential.
ADMIN_EMAIL=admin@vedra.local
ADMIN_PASSWORD=
DATA_DIR=./data
WORKER_ENABLED=true
SCHEDULER_ENABLED=true
PUBLIC_ORIGIN=http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
COOKIE_SECURE=false

# Exact domains only. An empty list disables outbound acquisition.
IMAGE_ALLOWED_DOMAINS=cdn-media.medialabtc.it,api.gabettigroup.com,www.abeimmobiliare.it
# Agency networks verified reachable for Scout (robots.txt allows listing pages).
# immobiliare.it, idealista and casa.it answer 403 to automated browsers: Vedra reports it, never bypasses it.
LIVE_ALLOWED_DOMAINS=www.tecnocasa.it,www.gabetti.it,www.remax.it,www.engelvoelkers.com,www.toscano.it,www.abeimmobiliare.it
BROWSER_ENABLED=true
BROWSER_EXECUTABLE_PATH=

# Optional, dedicated Hermes profile. Never expose this gateway to the public UI.
HERMES_BASE_URL=http://127.0.0.1:8645
HERMES_API_KEY=
VEDRA_BRIDGE_TOKEN=
HERMES_TIMEOUT_SECONDS=480

# PostgreSQL: direct connection or session pooler; leave empty for local SQLite.
DATABASE_URL=
DATABASE_SCHEMA=vedra
DATABASE_POOL_SIZE=4
WORKSPACE_NAME=Vedra

# Regolo Chat Completions. Set the key only in the private server environment.
AI_API_BASE_URL=https://api.regolo.ai/v1
AI_API_KEY=
AI_MODEL=qwen3.8-27b
AI_REASONING_EFFORT=low
AI_RESPONSE_FORMAT=json_object
AI_MAX_OUTPUT_TOKENS=4000
AI_TIMEOUT_SECONDS=120
# Scout reads pages with long reasoning: its own per-call limit, still bounded by RUN_TIMEOUT_SECONDS.
AI_SCOUT_TIMEOUT_SECONDS=240
AI_INPUT_EUR_PER_MILLION=0.5
AI_OUTPUT_EUR_PER_MILLION=2.1
AI_MAX_ANALYSES_PER_RUN=5

# National OMI public references and on-demand geometry/quote cache.
OMI_ENABLED=false

# Portal alert emails ("Avvisi dei portali"). Save the searches on immobiliare.it, idealista and casa.it
# with alerts sent to a dedicated mailbox; the worker reads it read-only (EXAMINE + BODY.PEEK, no deletes).
# Leave the host empty to only upload .eml files from Fonti. The password stays here: never in the DB or UI.
ALERTS_IMAP_HOST=
ALERTS_IMAP_PORT=993
ALERTS_IMAP_USER=
ALERTS_IMAP_PASSWORD=
ALERTS_IMAP_FOLDER=INBOX
ALERTS_POLL_MINUTES=15
# Only mail from these sender domains (and their subdomains) is read; anything else is ignored and counted.
ALERTS_SENDER_DOMAINS=immobiliare.it,idealista.it,idealista.com,casa.it
